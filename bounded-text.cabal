name:           bounded-text
version:        0.1.2.0
description:    Please see the README on GitHub at <https://github.com/flipstone/bounded-text#readme>
homepage:       https://github.com/flipstone/bounded-text#readme
bug-reports:    https://github.com/flipstone/bounded-text/issues
author:         Flipstone Technology Partners, Inc
maintainer:     development@flipstone.com
copyright:      2025 Flipstone Technology Partners, Inc
license:        BSD3
license-file:   LICENSE
build-type:     Simple
tested-with:
    GHC == 9.2.8, GHC == 9.4.8, GHC == 9.6.6, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.2
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/flipstone/bounded-text

flag ci
  description: More strict ghc options used for development and ci, not intended for end-use.
  manual: True
  default: False

library
  exposed-modules:
      Data.BoundedText
  other-modules:
      Paths_bounded_text
  hs-source-dirs:
      src
  build-depends:
      base >=4.16 && <5
    , deepseq >=1.4 && <1.7
    , template-haskell >=2.18 && <2.24
    , template-haskell-lift ==0.1.*
    , template-haskell-quasiquoter ==0.1.*
    , text >=1.2 && <3
  default-language: Haskell2010
  if flag(ci)
    ghc-options: -O2 -Wall -Werror -Wcompat -Widentities -Wmissing-local-signatures -Wmissing-export-lists -Wpartial-fields -Wmissed-specialisations -Wunused-packages -Wno-implicit-prelude -Wno-safe -Wno-unsafe
    if impl (ghc >= 9.0)
      ghc-options: -Winvalid-haddock
    if impl (ghc <= 9.3)
      ghc-options: -Wno-unticked-promoted-constructors
    if impl (ghc >= 9.0)
      ghc-options: -Winvalid-haddock
    if impl (ghc >= 9.4)
      ghc-options: -Wimplicit-lift -Woperator-whitespace -Wredundant-bang-patterns -Wredundant-strictness-flags
    if impl (ghc >= 9.6)
      ghc-options: -fplugin Henforcer
      build-depends:
          henforcer
    if impl (ghc >= 9.8)
      ghc-options: -Wincomplete-export-warnings -Wmissing-poly-kind-signatures -Wterm-variable-capture
    if impl (ghc >= 9.10)
      ghc-options: -Wdefaulted-exception-context
  else
    ghc-options: -O2

test-suite bounded-text-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Paths_bounded_text
  hs-source-dirs:
      test
  build-depends:
      base >=4.16 && <5
    , bounded-text
    , hedgehog
    , tasty
    , tasty-hedgehog
  default-language: Haskell2010
  if flag(ci)
    ghc-options: -O2 -Wall -Werror -Wcompat -Widentities -Wmissing-local-signatures -Wmissing-export-lists -Wpartial-fields -Wmissed-specialisations -Wno-implicit-prelude -Wno-safe -Wno-unsafe
    if impl (ghc >= 9.0)
      ghc-options: -Winvalid-haddock
    if impl (ghc <= 9.3)
      ghc-options: -Wno-unticked-promoted-constructors
    if impl (ghc >= 9.4)
      ghc-options: -Wimplicit-lift -Woperator-whitespace -Wredundant-bang-patterns -Wredundant-strictness-flags
    if impl (ghc >= 9.8)
      ghc-options: -Wincomplete-export-warnings -Wmissing-poly-kind-signatures -Wterm-variable-capture
    if impl (ghc >= 9.10)
      ghc-options: -Wdefaulted-exception-context
  else
    ghc-options: -threaded -rtsopts -with-rtsopts=-N -Wall -O2
